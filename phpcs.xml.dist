<?xml version="1.0"?>
<ruleset name="MCP Connector">
    <description>
        Security, escaping, i18n and PHP/WordPress compatibility checks.

        Formatting is Laravel Pint's job (PSR-12) — this ruleset deliberately
        excludes the WordPress *style* sniffs (snake_case, Yoda conditions,
        alignment) which contradict the codebase's modern PHP conventions.
    </description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <!-- Tests are not shipped and never run inside WordPress. Pest's closure API
         also trips PHPCompatibility's "$this outside a class" heuristic on every
         single test. They are covered by parallel-lint, Pint and the CI matrix. -->
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <!-- ================================================================
         Security: SQL injection, unescaped output, unsanitised input,
         nonce verification, unsafe file operations.
         ================================================================ -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.DB.RestrictedFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>

    <!-- ================================================================
         Correctness: deprecated APIs, cron/timezone traps, slow queries.
         ================================================================ -->
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedParameterValues"/>
    <rule ref="WordPress.WP.DiscouragedConstants"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>
    <rule ref="WordPress.WP.CapitalPDangit"/>
    <rule ref="WordPress.DateTime"/>
    <rule ref="WordPress.CodeAnalysis.AssignmentInTernaryCondition"/>
    <rule ref="WordPress.CodeAnalysis.EscapedNotTranslated"/>
    <rule ref="Generic.CodeAnalysis.AssignmentInCondition"/>
    <rule ref="Generic.PHP.DeprecatedFunctions"/>
    <rule ref="Squiz.PHP.NonExecutableCode"/>

    <!-- ================================================================
         Internationalisation: every user-facing string must be
         translatable and use this plugin's text domain.

         The domain is the intended wordpress.org slug, not the directory
         name. Language packs are keyed on the slug, so a domain that
         differs from it receives nothing.
         ================================================================ -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="amphibee-mcp-connector"/>
            </property>
        </properties>
    </rule>

    <!-- ================================================================
         Naming: hooks, options and globals must be namespaced so the
         plugin cannot collide with anything else on the site.
         ================================================================ -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="mcp_connector"/>
                <element value="Pollora\McpConnector"/>
            </property>
        </properties>
    </rule>

    <!-- ================================================================
         PHP / WordPress version compatibility. Kept in sync with the
         "Requires PHP" and "Requires at least" plugin headers.
         ================================================================ -->
    <config name="testVersion" value="8.3-"/>
    <config name="minimum_wp_version" value="6.9"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- ================================================================
         Distribution hygiene: the plugin header must stay well-formed.
         ================================================================ -->
    <rule ref="Generic.Files.ByteOrderMark"/>
    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Squiz.PHP.Eval"/>

    <!-- ================================================================
         Deliberate exemptions
         ================================================================ -->

    <!-- PHPCompatibility 9.x predates enums and parses an enum body as a plain
         function, so every `$this` inside an enum method is reported as a PHP 7.1
         error. Enums are PHP 8.1 and this plugin requires 8.3. -->
    <rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
        <severity>0</severity>
    </rule>

    <!-- Every hook this plugin fires is `apply_filters(self::SOME_FILTER, …)`,
         where the constant holds a literal already prefixed `mcp_connector_`.
         The sniff cannot resolve a class constant and reports all eight as
         dynamic. Declaring the names inline instead would mean eight string
         literals that no longer sit next to the documentation of what they do.

         The exemption is not taken on trust: ArchitectureTest asserts that
         every filter-name constant in src/ starts with the prefix, so this
         reintroduces the check the sniff was making, at a place that can
         actually see the values. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.DynamicHooknameFound">
        <severity>0</severity>
    </rule>

    <!-- base64 here is transport encoding required by specification, not
         obfuscation, in exactly three places:
           - Pkce: base64url of the SHA-256 challenge, per RFC 7636 §4.2;
           - TokenController: decoding HTTP Basic client credentials, per
             RFC 6749 §2.3.1;
           - ConnectionTest: encoding the same, to authenticate as the
             throwaway client it just created.
         There is no encoded payload anywhere in this plugin. -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
        <severity>0</severity>
    </rule>
</ruleset>
