#. Plugin Name of the plugin
#: mcp-connector.php
msgid "AmphiBee MCP Connector"
msgstr "AmphiBee MCP Connector"

#. Description of the plugin
#: mcp-connector.php
msgid "Exposes WordPress content management as Model Context Protocol tools, with a built-in OAuth 2.1 provider so remote clients such as Claude can connect to the site."
msgstr "Expõe o gerenciamento de conteúdo do WordPress como ferramentas do Model Context Protocol, com um provedor OAuth 2.1 integrado para que clientes remotos como o Claude possam se conectar ao site."

