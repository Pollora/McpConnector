#. Plugin Name of the plugin
#: mcp-connector.php
msgid "AmphiBee MCP Connector"
msgstr "AmphiBee MCP Connector"

#. Description of the plugin
#: mcp-connector.php
msgid "Exposes WordPress content management as Model Context Protocol tools, with a built-in OAuth 2.1 provider so remote clients such as Claude can connect to the site."
msgstr "Stellt die WordPress-Inhaltsverwaltung als Model-Context-Protocol-Werkzeuge bereit, mit einem eingebauten OAuth-2.1-Provider, damit sich entfernte Clients wie Claude mit der Website verbinden können."

