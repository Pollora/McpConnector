#. Plugin Name of the plugin
#: mcp-connector.php
msgid "AmphiBee MCP Connector"
msgstr "AmphiBee MCP Connector"

#. Description of the plugin
#: mcp-connector.php
msgid "Exposes WordPress content management as Model Context Protocol tools, with a built-in OAuth 2.1 provider so remote clients such as Claude can connect to the site."
msgstr "Stelt het beheer van WordPress-inhoud beschikbaar als Model Context Protocol-tools, met een ingebouwde OAuth 2.1-provider zodat externe clients zoals Claude verbinding kunnen maken met de site."

#. Author of the plugin
#: mcp-connector.php
msgid "AmphiBee"
msgstr "AmphiBee"

