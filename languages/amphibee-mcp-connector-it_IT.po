msgid "Writes — may delete or overwrite"
msgstr "Scrittura — può eliminare o sovrascrivere"

#: src/Server/ExternalAbility.php:108
msgid "Undeclared — the provider says nothing about what this does"
msgstr "Non dichiarata — il fornitore non dice nulla su ciò che questa fa"

