#. Plugin Name of the plugin
#: mcp-connector.php
msgid "AmphiBee MCP Connector"
msgstr "AmphiBee MCP Connector"

#. Description of the plugin
#: mcp-connector.php
msgid "Exposes WordPress content management as Model Context Protocol tools, with a built-in OAuth 2.1 provider so remote clients such as Claude can connect to the site."
msgstr "Espone la gestione dei contenuti di WordPress come strumenti Model Context Protocol, con un provider OAuth 2.1 integrato perché client remoti come Claude possano collegarsi al sito."

