#. Plugin Name of the plugin
#: mcp-connector.php
msgid "AmphiBee MCP Connector"
msgstr "AmphiBee MCP Connector"

#. Description of the plugin
#: mcp-connector.php
msgid "Exposes WordPress content management as Model Context Protocol tools, with a built-in OAuth 2.1 provider so remote clients such as Claude can connect to the site."
msgstr "Expone la gestión de contenidos de WordPress como herramientas del Model Context Protocol, con un proveedor OAuth 2.1 integrado para que clientes remotos como Claude puedan conectarse al sitio."

