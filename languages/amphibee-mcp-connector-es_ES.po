msgstr "Preparación"

#: src/Admin/Wizard.php:158
msgid "Reach"
msgstr "Alcance"

#: src/Admin/Wizard.php:159
msgid "The URL"
msgstr "La URL"

#: src/Admin/Wizard.php:160
msgid "Verify"
msgstr "Verificar"

#: src/Admin/Wizard.php:176
msgid "Setup steps"
msgstr "Pasos de la configuración"

#: src/Admin/Wizard.php:207
msgid "Leave the assistant"
msgstr "Salir del asistente"

