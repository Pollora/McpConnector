# Line endings — normalise in the repository, check out per platform.
* text=auto eol=lf
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.po  text eol=lf
*.pot text eol=lf
*.mo  binary
*.png binary
*.jpg binary
*.gif binary

# ---------------------------------------------------------------------------
# Everything below is development-only and must not reach the distributed zip.
# `git archive` honours export-ignore; the release workflow builds from it and
# then refuses to continue if anything on this list survived.
#
# The corollary is the part that is easy to forget: what must ship has to be
# *tracked and not listed here*. `assets/` and `languages/` are the two that
# have already caused an incident — without the stylesheet the settings screen
# renders unstyled, without the .mo files it renders in English.
# ---------------------------------------------------------------------------
/.github            export-ignore
/.wordpress-org     export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/tests              export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/phpcs.xml.dist     export-ignore
/pint.json          export-ignore
/composer.lock      export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/.phpunit.cache     export-ignore
